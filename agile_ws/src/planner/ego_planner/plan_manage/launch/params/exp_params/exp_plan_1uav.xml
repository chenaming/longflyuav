<launch>
    <!-- 单机真机 / 点云建图（grid_map.cpp），不含仿真与 map_size -->
    <arg name="uav_id" default="0"/>
    <arg name="odom_topic" default="/mavros/local_position/odom"/>
    <arg name="cloud_topic" default="/livox/lidar_map"/>
    <arg name="pose_topic" default="/unused_pose"/>
    <arg name="depth_topic" default="/unused_depth"/>
    <arg name="flight_type" default="1"/>
    <arg name="point_num" default="1"/>
    <arg name="target0_x" default="0.0"/>
    <arg name="target0_y" default="0.0"/>
    <arg name="target0_z" default="0.0"/>
    <arg name="target1_x" default="0.0"/>
    <arg name="target1_y" default="0.0"/>
    <arg name="target1_z" default="0.0"/>
    <arg name="target2_x" default="0.0"/>
    <arg name="target2_y" default="0.0"/>
    <arg name="target2_z" default="0.0"/>
    <arg name="target3_x" default="0.0"/>
    <arg name="target3_y" default="0.0"/>
    <arg name="target3_z" default="0.0"/>
    <arg name="target4_x" default="0.0"/>
    <arg name="target4_y" default="0.0"/>
    <arg name="target4_z" default="0.0"/>
    <arg name="max_vel" default="1.5"/>
    <arg name="max_acc" default="6.0"/>
    <arg name="max_jer" default="20.0"/>
    <arg name="planning_horizon" default="7.5"/>
    <arg name="use_multitopology_trajs" default="false"/>
    <arg name="local_update_range_x" default="5.5"/>
    <arg name="local_update_range_y" default="5.5"/>
    <arg name="local_update_range_z" default="2.0"/>
    <arg name="virtual_ceil" default="3.0"/>
    <arg name="virtual_ground" default="-5.0"/>
    <arg name="enable_virtual_wall" default="true"/>
    <arg name="obstacles_inflation" default="0.1"/>
    <arg name="obstacles_inflation_z" default="0.2"/><!-- Z 向膨胀半径 (m) -->
    <arg name="fail_safe" default="true"/>
    <include file="$(find ego_planner)/launch/params/exp_params/exp_plan_1uav_advanced_param_ringmap.xml">
        <arg name="uav_id" value="$(arg uav_id)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="pose_topic" value="$(arg pose_topic)"/>
        <arg name="depth_topic" value="$(arg depth_topic)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="$(arg max_acc)"/>
        <arg name="max_jer" value="$(arg max_jer)"/>
        <arg name="planning_horizon" value="$(arg planning_horizon)"/>
        <arg name="use_multitopology_trajs" value="$(arg use_multitopology_trajs)"/>
        <arg name="flight_type" value="$(arg flight_type)"/>
        <arg name="point_num" value="$(arg point_num)"/>
        <arg name="point0_x" value="$(arg target0_x)"/>
        <arg name="point0_y" value="$(arg target0_y)"/>
        <arg name="point0_z" value="$(arg target0_z)"/>
        <arg name="point1_x" value="$(arg target1_x)"/>
        <arg name="point1_y" value="$(arg target1_y)"/>
        <arg name="point1_z" value="$(arg target1_z)"/>
        <arg name="point2_x" value="$(arg target2_x)"/>
        <arg name="point2_y" value="$(arg target2_y)"/>
        <arg name="point2_z" value="$(arg target2_z)"/>
        <arg name="point3_x" value="$(arg target3_x)"/>
        <arg name="point3_y" value="$(arg target3_y)"/>
        <arg name="point3_z" value="$(arg target3_z)"/>
        <arg name="point4_x" value="$(arg target4_x)"/>
        <arg name="point4_y" value="$(arg target4_y)"/>
        <arg name="point4_z" value="$(arg target4_z)"/>
        <arg name="local_update_range_x" value="$(arg local_update_range_x)"/>
        <arg name="local_update_range_y" value="$(arg local_update_range_y)"/>
        <arg name="local_update_range_z" value="$(arg local_update_range_z)"/>
        <arg name="enable_virtual_wall" value="$(arg enable_virtual_wall)"/>
        <arg name="virtual_ceil" value="$(arg virtual_ceil)"/>
        <arg name="virtual_ground" value="$(arg virtual_ground)"/>
        <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
        <arg name="obstacles_inflation_z" value="$(arg obstacles_inflation_z)"/>
        <arg name="fail_safe" value="$(arg fail_safe)"/>
    </include>

    <node pkg="ego_planner" name="uav$(arg uav_id)_traj_server" type="traj_server" output="screen">
        <param name="~uav_id" value="$(arg uav_id)"/>
        <remap from="position_cmd" to="uav$(arg uav_id)_planning/pos_cmd"/>
        <remap from="~planning/trajectory" to="uav$(arg uav_id)_planning/trajectory"/>
        <remap from="~planning/yaw_align_active" to="/uav$(arg uav_id)_planning/yaw_align_active"/><!-- 订阅 planner 对齐状态；true 时暂停轨迹控制，避免与 YAW_ALIGN 抢权 -->
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <param name="traj_server/use_control_cmd" value="true" type="bool"/>
    </node>
</launch>
