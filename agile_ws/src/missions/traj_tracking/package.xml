<?xml version="1.0"?>
<package format="2">
  <name>traj_tracking_demo</name>
  <version>0.1.0</version>
  <description>Parametric trajectory tracking demo for uav_control_fsm (circle, square, triangle, hexagon, figure8)</description>
  <maintainer email="why@todo.todo">why</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>uav_control_fsm</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>uav_control_fsm</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
</package>
