<?xml version="1.0"?>
<package format="2">
  <name>lidar_world_mapper</name>
  <version>0.1.0</version>
  <description>
    Subscribe LiDAR clouds and odometry, transform to world, filter noise,
    accumulate a clean map, publish ROS cloud and save PCD.
  </description>
  <maintainer email="dev@agilebrain.local">agilebrain</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>tf</depend>
  <depend>message_filters</depend>
  <depend>std_srvs</depend>
  <depend>livox_ros_driver2</depend>
</package>
