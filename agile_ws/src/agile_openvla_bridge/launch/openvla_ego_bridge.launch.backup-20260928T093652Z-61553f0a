<launch>
  <arg name="server_url" default="http://10.62.25.215:5008/predict"/>
  <arg name="instruction" default="fly forward 1 meter"/>
  <arg name="dry_run" default="true"/>
  <arg name="enabled" default="false"/>
  <arg name="camera_alignment_confirmed" default="false"/>
  <arg name="camera_yaw_offset_deg" default="0.0"/>
  <arg name="image_topic" default="/uav1/odin1/image/compressed"/>
  <arg name="odom_topic" default="/uav1/mavros/local_position/odom"/>
  <arg name="goal_topic" default="/uav1/goal_point"/>
  <node pkg="agile_openvla_bridge" type="openvla_ego_bridge.py"
        name="openvla_ego_bridge" output="screen" required="true">
    <rosparam command="load" file="$(find agile_openvla_bridge)/config/bridge.yaml"/>
    <param name="server_url" value="$(arg server_url)"/>
    <param name="instruction" value="$(arg instruction)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="enabled" value="$(arg enabled)"/>
    <param name="camera_alignment_confirmed" value="$(arg camera_alignment_confirmed)"/>
    <param name="camera_yaw_offset_deg" value="$(arg camera_yaw_offset_deg)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="goal_topic" value="$(arg goal_topic)"/>
  </node>
</launch>
